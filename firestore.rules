// Firestore Security Rules — Firebase project `gurdiane-75091`
// Rewritten 2026-07-18 to match the ACTUAL shared schema of the three live
// clients on this project. The previous version of this file targeted the old
// `guardianeusf` camelCase schema (families / children / enhancedDailyLogging /
// childDeviceMappings …) and did NOT match anything here — do not restore it.
//
// ───────────────────────────────────────────────────────────────────────────
// THREE CLIENTS SHARE THIS PROJECT — what they are and how they auth:
//
//   1. GuardianeWeb        (Next.js)         — parent, AUTHENTICATED (email/pw)
//   2. GuardParent         (Expo Android)    — parent, AUTHENTICATED (email/pw)
//   3. Guardiane_Android   (RN child device) — child,  *** NO AUTH AT ALL ***
//
// ⚠️  HARD CONSTRAINT: the child device app uses NO Firebase Auth. Its "login"
// is a local QR/AsyncStorage scheme, so `request.auth` is ALWAYS null on its
// traffic. Every collection the child app reads or writes MUST therefore permit
// unauthenticated access, and NO rule on those paths may reference request.auth.
// Adding even Anonymous Auth to the child app is the prerequisite for locking
// these down further — until then, child-touched data is necessarily public.
//
// What this rewrite DOES improve over the previous wide-open state:
//   • Parent-only collections (aiInsights, chatSessions) require auth.
//   • Parent-only WRITES (users, emergency_contacts, modules, assignments,
//     deletes on messages/learning_progress) require auth + ownership.
//   • jojoLeads stays create-only + strictly shape-validated, never readable.
//   • Everything not explicitly listed is denied (default-deny at the bottom).
//
// Collections that are read/written by the no-auth child app and so remain
// publicly accessible by necessity: users(get), mood_entries, screen_time_entries,
// messages, alerts, conversations, learning_progress, lesson_streaks,
// module_assignments, modules(+lessons), emergency_contacts(read),
// access_requests, rewards. The child may also update exactly two status
// fields on its own users doc (see isChildDeviceStatusUpdate).
// ───────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Only these fields changed on an update.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── users ────────────────────────────────────────────────────────────────
    // Parents (both apps) and children both live here, distinguished by `role`.
    // Child app: reads a single user doc by id (its own child doc + its parent
    // doc) UNauthenticated — so `get` is public, but enumerating the collection
    // (`list`) requires auth. The child app never writes here; parent apps do.
    match /users/{userId} {
      allow get: if true;
      allow list: if isAuthenticated();

      // A parent may write their own doc, or a child doc they own (child docs
      // carry `parentId` == the parent's uid).
      allow create: if isAuthenticated() &&
                       (userId == request.auth.uid ||
                        request.resource.data.parentId == request.auth.uid);
      allow update, delete: if isAuthenticated() &&
                       (userId == request.auth.uid ||
                        resource.data.parentId == request.auth.uid);

      // The iOS child app (unauthenticated, like every child client) reports
      // its Screen Time status and that it is an iOS device, so the parent
      // dashboard can show the right controls. Child docs only, and nothing
      // else on the doc may change — not the parent link, not the limit.
      allow update: if resource.data.role == 'child' &&
                       onlyChanges(['screenTimeStatus', 'devicePlatform']) &&
                       request.resource.data.get('screenTimeStatus', {}) is map &&
                       request.resource.data.get('screenTimeStatus', {}).keys().hasOnly([
                         'authorized', 'isMonitoring', 'limitMinutes', 'baseLimitMinutes',
                         'bonusMinutesToday', 'selectedItemCount', 'authorizationMode',
                         'updatedAt']) &&
                       request.resource.data.get('devicePlatform', 'ios') in ['ios', 'android'];

      // GuardParent stores its JoJo history under the parent's own user doc.
      match /jojoConversations/{conversationId} {
        allow read, write: if isOwner(userId);
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ── mood_entries ─────────────────────────────────────────────────────────
    // Written + deleted by the child app (no auth); read by everyone.
    match /mood_entries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.childId is string;
      allow update: if false;   // no client updates mood entries in place
      allow delete: if true;    // child app prunes its own entries (unauth)
    }

    // ── screen_time_entries ──────────────────────────────────────────────────
    // Written + deleted by the child app (no auth); read by everyone.
    match /screen_time_entries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.childId is string;
      allow update: if false;
      allow delete: if true;
    }

    // ── messages (parent ↔ child chat) ───────────────────────────────────────
    // Both sides create; either side toggles isRead (child side is unauth, so
    // create/read/update cannot require auth). Only the parent apps delete.
    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.childId is string &&
                       request.resource.data.senderType in ['parent', 'child'];
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // ── alerts (child-app risk-alert dual-write, unauthenticated) ────────────
    // Added 2026-08-30: the child app's AlertService now writes every risk
    // detection to BOTH `messages` (chat-style, what the web currently reads)
    // AND this collection ("parent apps may listen to either"). Mirrors the
    // `messages` create/read/update shape below — same no-auth constraint,
    // since the writer is the same unauthenticated child app. `isRead` is the
    // only field any client mutates in place, so update stays wide open like
    // `messages`; only an authenticated parent may delete.
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if request.resource.data.childId is string &&
                       request.resource.data.parentId is string;
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // ── conversations (child-app JoJo history) ───────────────────────────────
    // Child app only, fully unauthenticated.
    match /conversations/{conversationId} {
      allow read, create, update: if true;
      allow delete: if false;
      match /messages/{messageId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // ── emergency_contacts ───────────────────────────────────────────────────
    // Read by the child app (unauth). Only the owning parent writes.
    match /emergency_contacts/{contactId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.parentId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
                       resource.data.parentId == request.auth.uid;
    }

    // ── modules (+ lessons) — shared learning content ────────────────────────
    // Read by the child app (unauth). Written by authenticated parents, with
    // the same ownership policy every parent app already applies in code:
    //   • a module with a `createdBy` is edited only by that parent, and only
    //     that parent adds or edits its lessons;
    //   • a creator-less module (a built-in placeholder) accepts lessons from
    //     any parent. GuardParent (Android) creates those placeholders on
    //     demand with only { moduleId, createdAt, updatedAt } (ensureModuleDoc),
    //     and the iOS parent app bumps their lessonCount after adding a lesson.
    // Seeded built-in content is written with the Admin SDK, which bypasses
    // these rules.
    function creatorOf(data) {
      return data.get('createdBy', null);
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
                       creatorOf(request.resource.data) == request.auth.uid ||
                       (creatorOf(request.resource.data) == null &&
                        request.resource.data.keys().hasOnly(['moduleId', 'createdAt', 'updatedAt'])));
      allow update: if isAuthenticated() && (
                       (creatorOf(resource.data) == request.auth.uid &&
                        creatorOf(request.resource.data) == request.auth.uid) ||
                       (creatorOf(resource.data) == null &&
                        onlyChanges(['lessonCount', 'updatedAt'])));
      allow delete: if isAuthenticated() &&
                       creatorOf(resource.data) == request.auth.uid;

      match /lessons/{lessonId} {
        allow read: if true;
        // getAfter: the web and iOS apps create a module and its first lesson
        // in one batch, so the module only exists in the post-write state.
        allow create: if isAuthenticated() &&
                         creatorOf(getAfter(/databases/$(database)/documents/modules/$(moduleId)).data) in [null, request.auth.uid] &&
                         creatorOf(request.resource.data) in [null, request.auth.uid];
        allow update, delete: if isAuthenticated() && (
                         creatorOf(resource.data) == request.auth.uid ||
                         creatorOf(get(/databases/$(database)/documents/modules/$(moduleId)).data) == request.auth.uid);
      }
    }

    // ── module_assignments ───────────────────────────────────────────────────
    // Read by the child app (unauth). Written by authenticated parents.
    match /module_assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // ── learning_progress ────────────────────────────────────────────────────
    // Written by the child app as it completes lessons (no auth). Parents read
    // and may delete.
    match /learning_progress/{progressId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // ── lesson_streaks (child-app only) ──────────────────────────────────────
    match /lesson_streaks/{childId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── access_requests (child asks for extra app time) ──────────────────────
    // Created by the unauthenticated iOS child app — strictly shape-checked and
    // always pending. Only the owning parent answers. The child's device may
    // then stamp `appliedAt`, once, after granting the approved minutes.
    function validAccessRequest(data) {
      return data.keys().hasOnly(['childId', 'parentId', 'moduleId', 'moduleTitle',
                                  'requestType', 'status', 'requestedAt']) &&
             data.childId is string && data.parentId is string &&
             data.moduleId is string && data.moduleId.size() <= 200 &&
             data.moduleTitle is string && data.moduleTitle.size() <= 200 &&
             data.requestType == 'app_access' &&
             data.status == 'pending' &&
             data.requestedAt is timestamp;
    }
    match /access_requests/{requestId} {
      allow read: if true;
      allow create: if validAccessRequest(request.resource.data);
      allow update: if (isAuthenticated() &&
                        resource.data.parentId == request.auth.uid &&
                        onlyChanges(['status', 'grantedMinutes', 'respondedAt']) &&
                        request.resource.data.status in ['approved', 'denied'] &&
                        (request.resource.data.status == 'denied' ||
                         (request.resource.data.grantedMinutes is int &&
                          request.resource.data.grantedMinutes >= 1 &&
                          request.resource.data.grantedMinutes <= 240))) ||
                       (resource.data.status == 'approved' &&
                        !('appliedAt' in resource.data) &&
                        onlyChanges(['appliedAt']));
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }

    // ── rewards (badges the child claims) ────────────────────────────────────
    // Created once by the unauthenticated iOS child app (deterministic id per
    // badge, so re-claiming is an update and is refused). Read-only after.
    match /rewards/{rewardId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['childId', 'parentId', 'type', 'badge',
                                                             'title', 'reason', 'claimedAt']) &&
                       request.resource.data.childId is string &&
                       request.resource.data.parentId is string &&
                       request.resource.data.type == 'badge' &&
                       request.resource.data.badge is string && request.resource.data.badge.size() <= 60 &&
                       request.resource.data.title is string && request.resource.data.title.size() <= 100 &&
                       request.resource.data.reason is string && request.resource.data.reason.size() <= 200 &&
                       request.resource.data.claimedAt is timestamp;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }

    // ── screen_time_unlocks — deliberately absent ────────────────────────────
    // One-time codes that unlock the Screen Time settings on a child's iPhone.
    // Only the web server's Admin SDK touches them (app/api/screen-time/*), so
    // no client may read or write them: the default deny below covers it.

    // ── aiInsights (GuardParent only, authenticated) ─────────────────────────
    match /aiInsights/{childId} {
      allow read, write: if isAuthenticated();
    }

    // ── chatSessions (GuardianeWeb JoJo history, per-user) ───────────────────
    match /chatSessions/{sessionId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.createdAt is timestamp;
      // Updates may not reassign ownership or rewrite createdAt.
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated() &&
                         get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid &&
                         request.resource.data.timestamp is timestamp;
        allow update, delete: if false;   // messages are immutable
      }
    }

    // ── jojoLeads (public, login-free chatbot lead capture) ──────────────────
    // The ONLY intentionally-unauthenticated WRITE with a strict shape check.
    // Never client-readable — the team reads leads from the Firebase console.
    function validJojoLead(data) {
      return data.keys().hasOnly(['email', 'phone', 'name', 'childInfo', 'zip', 'source', 'createdAt']) &&
             data.createdAt is timestamp &&
             data.email is string && data.email.size() <= 254 &&
             data.phone is string && data.phone.size() <= 32 &&
             (data.email.size() >= 3 || data.phone.size() >= 7) &&
             data.name is string && data.name.size() <= 100 &&
             data.childInfo is string && data.childInfo.size() <= 500 &&
             data.zip is string && data.zip.size() <= 20 &&
             data.source is string && data.source.size() <= 40;
    }
    match /jojoLeads/{leadId} {
      allow create: if validJojoLead(request.resource.data);
      allow read, update, delete: if false;
    }

    // ── DEFAULT DENY — anything not matched above is rejected ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
